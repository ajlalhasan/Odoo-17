<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action: also available from the "Action" (gear) menu, in list and form,
         so several quotations can be flagged at once. Same logic as the header button. -->
    <record id="action_server_request_manager_approval" model="ir.actions.server">
        <field name="name">Request Manager Approval</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_request_manager_approval()</field>
    </record>
</odoo>
